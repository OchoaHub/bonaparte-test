# Ruby / Bundler
/.bundle/
/vendor/bundle
*.gem
*.rbc

# Rails (cuando se genere la app)
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/public/assets
.byebug_history

# Env & secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Output generado por la prueba (no commitear entregables finales si son grandes)
/output/*.xlsx
!/output/.keep
